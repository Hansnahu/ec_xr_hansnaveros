# Unity - artefactos de build y crash reports
# ============================================================
sysinfo.txt
crashlytics-build.properties
*.apk
*.aab
*.unitypackage
*.app

# ============================================================
# Excepción: las capturas de evidencia SI se versionan
# ============================================================
!Assets/Screenshots/
!Assets/Screenshots/*.png
!Assets/Screenshots/*.png.meta
